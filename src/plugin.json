{
  "$schema": "https://raw.githubusercontent.com/grafana/grafana/main/docs/sources/developers/plugins/plugin.schema.json",
  "type": "datasource",
  "name": "OpenObserve Traces",
  "id": "gresearch-openobservetraces-datasource",
  "category": "tracing",
  "tracing": true,
  "backend": true,
  "executable": "gpx_openobserve_traces",
  "info": {
    "description": "Visualize distributed traces stored in OpenObserve using Grafana's native trace view.",
    "author": {
      "name": "G-Research"
    },
    "keywords": ["datasource", "tracing", "traces", "openobserve", "opentelemetry"],
    "logos": {
      "small": "img/logo.svg",
      "large": "img/logo.svg"
    },
    "links": [
      { "name": "Source", "url": "https://github.com/dcoric/openobserve-traces-grafana-plugin" },
      {
        "name": "Documentation",
        "url": "https://github.com/dcoric/openobserve-traces-grafana-plugin/blob/main/README.md"
      },
      { "name": "Issues", "url": "https://github.com/dcoric/openobserve-traces-grafana-plugin/issues" }
    ],
    "screenshots": [
      { "name": "Structured trace search with seeded OpenObserve data", "path": "img/trace-search.png" },
      { "name": "Native Grafana waterfall with error spans", "path": "img/trace-waterfall.png" },
      { "name": "Span details, resource attributes and exception events", "path": "img/span-details.png" }
    ],
    "version": "%VERSION%",
    "updated": "%TODAY%"
  },
  "dependencies": {
    "grafanaDependency": ">=12.0.0",
    "plugins": []
  }
}
